// Intentionally has no include guard: C++ and HLSL include this file multiple
// times with one of the two macros defined. Keep this file preprocessor-only.
#ifndef CS_DEFERRED_EVALUATOR
#define CS_DEFERRED_EVALUATOR(cppName, hlslName, value, red, green, blue)
#define CS_DEFERRED_UNDEF_EVALUATOR
#endif
#ifndef CS_DEFERRED_MATERIAL
#define CS_DEFERRED_MATERIAL(name, value, cppEvaluator, hlslEvaluator)
#define CS_DEFERRED_UNDEF_MATERIAL
#endif

// Registry arguments deliberately use a CSReg prefix. FXC expands macro
// arguments eagerly, and ordinary names such as TRUE_PBR and HAIR collide
// with forward-shader permutation macros.
//
// Deferred coverage and remaining contracts (keep this ledger beside the ABI):
//
//   Active, fully resolved during rasterization:
//     Generic              Standard/alpha-tested diffuse and specular, plain
//                          diffuse/specular foliage, terrain, object LOD, and
//                          non-PBR LOD land.
//     Grass                Resolved grass surface, IBL/skylighting inputs.
//     DistantTree          Directional/ambient distant-tree surface.
//     FoliageSpecial       Non-specular soft/rim/back-light foliage payload.
//     TruePbr              Core/emissive/projected resolved surface.
//     TruePbrSubsurfaceFuzz Resolved SSS, thickness, fuzz, and tree transmission.
//     TruePbrCoat          Resolved coat color/normal/roughness (no interlayer
//                          displacement).
//     TruePbrGlint         Raster-resolved cache footprint/noise/tangent inputs.
//     TruePbrTerrain       Resolved non-advanced landscape surface.
//
//   Reserved/compatibility; no material-texture sharing is inherently required:
//     Skin                 Curvature, dual-specular, SSS/fuzz and wetness payload.
//     Hair                 Tangent/flow, vertex normal, noise/settings and the
//                          shared-depth hair self-shadow helper. HairMarschner is
//                          part of this dedicated evaluator, not TruePBR core.
//     EyeEnvmap            Eye normal plus raster-resolved environment result.
//     TruePbrLodBlend      Two independently lit resolved surfaces plus blend data;
//                          requires the extended-payload/replay contract.
//     Glow/snow/aniso/sparkle variants need resolved emissive or specialized
//                          light-dependent parameters and dedicated identities.
//     Terrain/projected glints can use raster-resolved caches but exceed the
//                          current inline terrain payload.
//
//   Reserved/compatibility until material textures can be shared with D3D12:
//     TruePbrParallax      Per-light object displacement self-shadow sampling.
//     TruePbrTerrainAdvanced Per-light terrain displacement/parallax sampling
//                          (glint-only intersections may later be split out).
//     Extended-material parallax and multilayer displacement variants likewise
//                          require per-light sampling of their original textures.
//
// Transparent/order-dependent materials remain forward and are not registry
// candidates. Evaluator availability is still determined from successfully
// created PSOs; this ledger describes the complete intended material contract.
CS_DEFERRED_EVALUATOR(CSRegCompatibility, CSREG_COMPATIBILITY, 0, 0.00, 0.00, 0.00)
CS_DEFERRED_EVALUATOR(CSRegGeneric, CSREG_GENERIC, 1, 0.00, 1.00, 0.00)
CS_DEFERRED_EVALUATOR(CSRegTruePbr, CSREG_TRUEPBR, 2, 0.00, 0.75, 1.00)
CS_DEFERRED_EVALUATOR(CSRegGrass, CSREG_GRASS, 3, 1.00, 1.00, 0.00)
CS_DEFERRED_EVALUATOR(CSRegDistantTree, CSREG_DISTANT_TREE, 4, 1.00, 0.35, 0.00)
CS_DEFERRED_EVALUATOR(CSRegSkin, CSREG_SKIN, 5, 1.00, 0.00, 0.45)
CS_DEFERRED_EVALUATOR(CSRegHair, CSREG_HAIR, 6, 0.65, 0.00, 1.00)
CS_DEFERRED_EVALUATOR(CSRegEyeEnvmap, CSREG_EYE_ENVMAP, 7, 0.00, 0.25, 1.00)
CS_DEFERRED_EVALUATOR(CSRegFoliageSpecial, CSREG_FOLIAGE_SPECIAL, 8, 1.00, 0.00, 1.00)
CS_DEFERRED_EVALUATOR(CSRegTruePbrSubsurfaceFuzz, CSREG_TRUEPBR_SUBSURFACE_FUZZ, 9, 1.00, 0.15, 0.55)
CS_DEFERRED_EVALUATOR(CSRegTruePbrCoat, CSREG_TRUEPBR_COAT, 10, 0.10, 0.85, 1.00)
CS_DEFERRED_EVALUATOR(CSRegTruePbrGlint, CSREG_TRUEPBR_GLINT, 11, 1.00, 0.85, 0.05)
CS_DEFERRED_EVALUATOR(CSRegTruePbrParallax, CSREG_TRUEPBR_PARALLAX, 12, 0.85, 0.25, 1.00)
CS_DEFERRED_EVALUATOR(CSRegTruePbrTerrain, CSREG_TRUEPBR_TERRAIN, 13, 0.15, 0.75, 0.20)
CS_DEFERRED_EVALUATOR(CSRegTruePbrTerrainAdvanced, CSREG_TRUEPBR_TERRAIN_ADVANCED, 14, 0.85, 0.55, 0.05)
CS_DEFERRED_EVALUATOR(CSRegTruePbrLodBlend, CSREG_TRUEPBR_LOD_BLEND, 15, 0.10, 0.95, 0.80)

CS_DEFERRED_MATERIAL(CSRegLegacy, 0, CSRegCompatibility, CSREG_COMPATIBILITY)
CS_DEFERRED_MATERIAL(CSRegStandardOpaque, 1, CSRegGeneric, CSREG_GENERIC)
CS_DEFERRED_MATERIAL(CSRegAlphaTestedOpaque, 2, CSRegGeneric, CSREG_GENERIC)
CS_DEFERRED_MATERIAL(CSRegStandardSpecular, 3, CSRegGeneric, CSREG_GENERIC)
CS_DEFERRED_MATERIAL(CSRegAlphaTestedSpecular, 4, CSRegGeneric, CSREG_GENERIC)
CS_DEFERRED_MATERIAL(CSRegFoliage, 5, CSRegGeneric, CSREG_GENERIC)
CS_DEFERRED_MATERIAL(CSRegTerrain, 6, CSRegGeneric, CSREG_GENERIC)
CS_DEFERRED_MATERIAL(CSRegTerrainSpecular, 7, CSRegGeneric, CSREG_GENERIC)
// Geometry LOD is a resolved-surface variant of Generic. Distant landscape
// still needs its separately composed LOD-land contract and remains diagnostic.
CS_DEFERRED_MATERIAL(CSRegLodObject, 8, CSRegGeneric, CSREG_GENERIC)
CS_DEFERRED_MATERIAL(CSRegFoliageSpecular, 9, CSRegGeneric, CSREG_GENERIC)
// Raster-resolved terrain blending classes. Float MRTs contain the in-place
// interpolation of receiver and terrain; identity remains discrete in MASKS2.
// Keep these distinct so a future canonical-PBR blend contract can dispatch to
// a dedicated evaluator without changing the generic ABI.
CS_DEFERRED_MATERIAL(CSRegBlendedGeneric, 10, CSRegGeneric, CSREG_GENERIC)
CS_DEFERRED_MATERIAL(CSRegBlendedGenericSpecular, 11, CSRegGeneric, CSREG_GENERIC)
CS_DEFERRED_MATERIAL(CSRegTruePbr, 32, CSRegTruePbr, CSREG_TRUEPBR)
CS_DEFERRED_MATERIAL(CSRegTruePbrTerrain, 33, CSRegTruePbrTerrain, CSREG_TRUEPBR_TERRAIN)
CS_DEFERRED_MATERIAL(CSRegTruePbrSubsurfaceFuzz, 34, CSRegTruePbrSubsurfaceFuzz, CSREG_TRUEPBR_SUBSURFACE_FUZZ)
CS_DEFERRED_MATERIAL(CSRegTruePbrCoat, 35, CSRegTruePbrCoat, CSREG_TRUEPBR_COAT)
CS_DEFERRED_MATERIAL(CSRegTruePbrGlint, 36, CSRegTruePbrGlint, CSREG_TRUEPBR_GLINT)
CS_DEFERRED_MATERIAL(CSRegTruePbrParallax, 37, CSRegTruePbrParallax, CSREG_TRUEPBR_PARALLAX)
CS_DEFERRED_MATERIAL(CSRegTruePbrTerrainAdvanced, 38, CSRegTruePbrTerrainAdvanced, CSREG_TRUEPBR_TERRAIN_ADVANCED)
CS_DEFERRED_MATERIAL(CSRegTruePbrLodBlend, 39, CSRegTruePbrLodBlend, CSREG_TRUEPBR_LOD_BLEND)
// Reserved: mixed PBR/legacy receivers require canonicalized PBR MRT semantics.
CS_DEFERRED_MATERIAL(CSRegBlendedPbr, 40, CSRegTruePbr, CSREG_TRUEPBR)
CS_DEFERRED_MATERIAL(CSRegGrass, 64, CSRegGrass, CSREG_GRASS)
// Dedicated non-generic evaluators. Each class is enabled only when its PSO
// and complete material contract are available at runtime.
CS_DEFERRED_MATERIAL(CSRegDistantTree, 65, CSRegDistantTree, CSREG_DISTANT_TREE)
CS_DEFERRED_MATERIAL(CSRegFoliageSpecial, 66, CSRegFoliageSpecial, CSREG_FOLIAGE_SPECIAL)
CS_DEFERRED_MATERIAL(CSRegLodLand, 67, CSRegGeneric, CSREG_GENERIC)
// Reserved contracts remain compatibility pixels until their evaluators exist.
CS_DEFERRED_MATERIAL(CSRegSkin, 96, CSRegSkin, CSREG_SKIN)
CS_DEFERRED_MATERIAL(CSRegHair, 97, CSRegHair, CSREG_HAIR)
CS_DEFERRED_MATERIAL(CSRegEyeEnvmap, 98, CSRegEyeEnvmap, CSREG_EYE_ENVMAP)

#ifdef CS_DEFERRED_UNDEF_EVALUATOR
#undef CS_DEFERRED_EVALUATOR
#undef CS_DEFERRED_UNDEF_EVALUATOR
#endif
#ifdef CS_DEFERRED_UNDEF_MATERIAL
#undef CS_DEFERRED_MATERIAL
#undef CS_DEFERRED_UNDEF_MATERIAL
#endif
