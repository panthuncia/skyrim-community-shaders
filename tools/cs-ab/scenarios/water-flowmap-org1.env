# Unified Water's flowmap built by the D3D11 path (0) or without D3D11 (1, CS_ORG_UNIFIED_WATER). The flowmap is rebuilt at
# every start (CS_UNIFIED_WATER_REGENERATE_FLOWMAP), so the log's "[Unified Water] [Flowmap] Generated in ... file hash" line
# must show the same hash in both runs. Then the river at Riverwood at 13:00, clear weather, a shot.
CS_ORG_UNIFIED_WATER=1
CS_UNIFIED_WATER_REGENERATE_FLOWMAP=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Riverwood;2000:fw 81a;2400:dclf:shot=riverwood
CS_DCLF_TEST_EXIT=2500
