# Native residue census tour (Phase 6, native Vulkan): every engine draw that still reaches the native context is a missing draw.
# native-validation.env without validation, with the residue census: Whiterun, the inventory, the map, the journal, a save and its
# load, then Dragonsreach (an interior) and back out to Whiterun, a shot at each, exit at frame 3600. Read the "[ORG] residue census"
# lines (each 60-frame window, to place a class at its transition; the transitions are the windows around coc and the load), the "[ORG] flush latch: engine" [E] lines
# (one per site), the "[ORG] ImageSpace: draws and dispatches left to D3D11" lines and the "[ORG] tripwire" report.
# cs-ab: disable-mod=Skyrim Engine Telemetry
# cs-ab: disable-mod=ImprovedCameraSE
CS_ORG_NATIVE=1
CS_DISABLE_FEATURES=Upscaling
CS_ORG_TRIPWIRE_LOG=1
CS_ORG_RESIDUE_CENSUS=1
CS_ORG_RESIDUE_CENSUS_FRAMES=60
CS_ORG_RESIDUE_CENSUS_TOP=60
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=500:dclf:shot=start;600:set timescale to 0;601:set gamehour to 13;700:coc Whiterun;1200:dclf:shot=whiterun;1250:dclf:menu=InventoryMenu=show;1400:dclf:shot=inventory;1450:dclf:menu=InventoryMenu=hide;1500:dclf:menu=MapMenu=show;1650:dclf:shot=map;1700:dclf:menu=MapMenu=hide;1750:dclf:menu=Journal Menu=show;1850:dclf:shot=journal;1900:dclf:menu=Journal Menu=hide;1950:dclf:save=nativecensus;2050:dclf:load=recent;2500:dclf:shot=loaded;2600:coc WhiterunDragonsreach;3000:dclf:shot=dragonsreach;3100:coc Whiterun;3500:dclf:shot=whiterun2
CS_DCLF_TEST_EXIT=3600
