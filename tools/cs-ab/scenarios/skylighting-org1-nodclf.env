# Skylighting's probe update on D3D11 (CS_ORG_SKYLIGHTING=0) or the render graph (1), DCLF off: Whiterun at noon
# and Dragonsreach, shots a fixed number of frames after each cell load (the probes are temporal).
CS_ORG_SKYLIGHTING=1
CS_DCLF=0
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=300:coc Whiterun;1000:set gamehour to 12;1500:dclf:shot=whiterun;1600:coc WhiterunDragonsreach;2500:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=2600
