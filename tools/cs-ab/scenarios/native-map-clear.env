# Native world map against map-short.env (the guest map check): the same commands, so the weather (SkyrimClear_A, forced) and the
# hour match, and the two map shots compare. Native mode turns on every port switch itself, CS_ORG_SKY_CLOUDS among them, which
# map-short.env leaves off (the cloud layers stay the engine's there). The map census lines ("[DCLF] map census") and the map hold's
# "[DCLF] load hold" line come with every map open.
# cs-ab: disable-mod=Skyrim Engine Telemetry
# cs-ab: disable-mod=ImprovedCameraSE
CS_ORG_NATIVE=1
CS_DISABLE_FEATURES=Upscaling
CS_ORG_RESIDUE_CENSUS=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;700:coc Whiterun;1300:set timescale to 20;1310:dclf:weather=SkyrimClear_A;1400:set timescale to 0;1401:set gamehour to 13;1500:dclf:shot=whiterun;1950:dclf:menu=MapMenu=show;2200:dclf:shot=map;2250:dclf:menu=MapMenu=hide
CS_DCLF_TEST_EXIT=2300
