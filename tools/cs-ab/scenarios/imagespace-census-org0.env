# The census of imagespace-census.env with the ImageSpace port off: the ImageSpace classes it should remove, for comparison.
CS_ORG_RESIDUE_CENSUS=1
CS_ORG_RESIDUE_CENSUS_FRAMES=300
CS_ORG_RESIDUE_CENSUS_TOP=60
CS_ORG_TRIPWIRE_GUEST=1
CS_ORG_ENGINE_CONSTANTS=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2900:coc WhiterunDragonsreach;4000:dclf:shot=dragonsreach;4100:coc Riverwood;5200:fw 81a;5500:dclf:shot=riverwood
CS_DCLF_TEST_EXIT=5600
