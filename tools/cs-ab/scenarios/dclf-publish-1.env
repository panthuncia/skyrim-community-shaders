# DCLF's frame textures reading the ported producers' published textures: fog (t19, t22), IBL (t76, t77), Skylighting (t50, t53),
# Terrain Shadows (t60), Volumetric Shadows (t18), Cloud Shadows (t25), all on the graph. dclf-publish-0.env is the D3D11 reference.
# Needs the volumetric fog on in SettingsUser.json. Look for "[DCLF] frame texture ... reads the graph resource" once per texture.
CS_ORG_EXPONENTIAL_HEIGHT_FOG=1
CS_ORG_IBL=1
CS_ORG_SKYLIGHTING=1
CS_ORG_TERRAIN_SHADOWS=1
CS_ORG_VOLUMETRIC_SHADOWS=1
CS_ORG_CLOUD_SHADOWS=1
CS_ORG_LIGHT_LIMIT_FIX_SHADOWS=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2500:coc WhiterunDragonsreach;3600:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=3700
