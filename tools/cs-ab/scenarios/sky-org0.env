# The D3D11 reference for sky-org1.env: the same tour with the engine drawing the sky (CS_ORG_SKY unset). Cloud Shadows' copy is
# on the graph in both (CS_ORG_CLOUD_SHADOWS=1), as the sky family needs it. Whiterun at 13:00 and 22:00 in cloudy weather (12f2d),
# a shot up at the sky and one at the horizon each time, then Dragonsreach (no sky: the batch has no draws).
CS_ORG_CLOUD_SHADOWS=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 12f2d;700:coc Whiterun;2000:fw 12f2d;2100:player.setangle x -35;2400:dclf:shot=sky-noon;2410:player.setangle x 0;2600:dclf:shot=whiterun;2610:set gamehour to 22;2620:player.setangle x -35;3000:dclf:shot=sky-night;3010:player.setangle x 0;3200:dclf:shot=whiterun-night;3300:coc WhiterunDragonsreach;4400:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=4500
