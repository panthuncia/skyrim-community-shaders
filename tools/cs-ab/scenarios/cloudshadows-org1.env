# Cloud Shadows' occlusion copy on D3D11 (0) or the render graph (1, CS_ORG_CLOUD_SHADOWS). Outside Whiterun's walls, time
# frozen at 13:00, cloudy weather (12f2d), a shot after the weather settles and one after a turn of the reflection faces.
CS_ORG_CLOUD_SHADOWS=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=400:coc Whiterun;1300:set timescale to 0;1310:set gamehour to 13;1320:fw 12f2d;2000:dclf:shot=clouds1;2300:dclf:shot=clouds2
CS_DCLF_TEST_EXIT=2400
