# menus-org0.env with the menu views' probe on (CS_ORG_MENU3D=1, CS_ORG_MAP=1). The engine still draws every menu scene, so the shots
# must match menus-org0.env's. The log has one "[DCLF] menu views:" line per menu scene shape (scheme, targets, stencil, geometry
# tracked by DCLF's scene, world frame or not, and the verdict). The local map needs its tab opened by hand (no test command).
CS_ORG_MENU3D=1
CS_ORG_MAP=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_CENSUS=1
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;700:coc Whiterun;2000:dclf:shot=whiterun;2100:dclf:menu=InventoryMenu=show;2500:dclf:shot=inventory;2510:dclf:menu=InventoryMenu=hide;2600:dclf:menu=MagicMenu=show;3000:dclf:shot=magic;3010:dclf:menu=MagicMenu=hide;3100:dclf:menu=StatsMenu=show;3600:dclf:shot=stats;3610:dclf:menu=StatsMenu=hide;3700:dclf:menu=Journal Menu=show;4100:dclf:shot=journal;4110:dclf:menu=Journal Menu=hide;4200:dclf:menu=MapMenu=show;4700:dclf:shot=worldmap;4710:dclf:menu=MapMenu=hide;4800:showracemenu;5400:dclf:shot=racemenu
CS_DCLF_TEST_EXIT=5500
