# Blood impact particles drawn by DCLF (dclf-roadmap.md 4.3): pBloodSplat02, pBloodDrops06 and pBloodLines are the particle systems of
# master particle systems (meshes\mps\mpsbloodsplatimpact02.nif, mpsbloodspraytiny03.nif), fed by the impact effect's emitters, so
# CS_DCLF_MASTER_PARTICLES=1 takes them; against blood-particles-0.env. Riverwood by day, third person, one melee bandit (1bcd8)
# placed at the player, whose health is raised: each hit sprays blood. Shots during the fight, then AI off.
# In the log: the report's "master particles ... attaches" and "idle removals hooked" above 0 after the fight (blood masters come and
# go), "left with no event ... <- OK", "held past removal ... <- OK", and no "<- PARTICLES". In the shots: the blood sprays on the
# player look as in blood-particles-0.env (their placement is the engine's random draw: compare their look, not their pixels).
CS_DCLF_MASTER_PARTICLES=1
CS_DCLF_STATS=1
CS_DCLF_SET_PARITY=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;700:coc Riverwood;1800:dclf:pov=third;1820:player.setav health 100000;1830:player.placeatme 1bcd8 1;2100:dclf:shot=blood1;2140:dclf:shot=blood2;2180:dclf:shot=blood3;2220:dclf:shot=blood4;2400:tai;3000:dclf:shot=after
CS_DCLF_TEST_EXIT=3100
