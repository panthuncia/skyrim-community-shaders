# Fast iteration on native D3D12: the autoloaded save, one shot, exit. About a minute with a warm shader cache.
# Read DCLF's "[DCLF] D3D12: on" line, "D3D12 InfoQueue" lines (with CS_ORG_NATIVE_VALIDATION=1) and the start shot.
# cs-ab: disable-mod=Skyrim Engine Telemetry
# cs-ab: disable-mod=ImprovedCameraSE
CS_ORG_NATIVE=1
CS_ORG_NATIVE_BACKEND=d3d12
CS_DISABLE_FEATURES=Upscaling
DXVK_DEBUG=hang
CS_DCLF_TEST_COMMANDS=150:dclf:shot=start
CS_DCLF_TEST_EXIT=200
