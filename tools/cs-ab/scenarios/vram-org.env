# VRAM attribution read from BasicRHI's memory budget and ORG's allocator (CS_ORG_VRAM_SOURCE=org), streaming windows on D3D11.
CS_ORG_VRAM_SOURCE=org
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=300:coc Whiterun;1500:dclf:tex-stats;1501:dclf:vram-json;2500:coc WhiterunDragonsreach;3400:dclf:tex-stats;3401:dclf:vram-json
CS_DCLF_TEST_EXIT=3500
