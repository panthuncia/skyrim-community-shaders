# Exponential Height Fog's volumetric fog on D3D11 (0) or ORG (1). Its inputs' features run on the graph in both, so only the fog
# differs. Needs the fog on in SettingsUser.json ("Exponential Height Fog": enabled 1, volumetricFogEnabled 1, fogDensity > 0).
# Whiterun at 13:00 in clear weather, then Dragonsreach (local lights and shadows), a shot of each.
CS_ORG_EXPONENTIAL_HEIGHT_FOG=1
CS_ORG_IBL=1
CS_ORG_SKYLIGHTING=1
CS_ORG_TERRAIN_SHADOWS=1
CS_ORG_LIGHT_LIMIT_FIX_SHADOWS=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2500:coc WhiterunDragonsreach;3600:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=3700
