# Batch 1 A/B: every ported feature on the graph (1) or D3D11 (0), shots at Whiterun and Dragonsreach with time and AI stopped.
CS_ORG_COMPOSITE=0
CS_ORG_IBL=0
CS_ORG_TERRAIN_SHADOWS=0
CS_ORG_VOLUMETRIC_SHADOWS=0
CS_ORG_GRASS_COLLISION=0
CS_ORG_SKYLIGHTING=0
CS_ORG_SCREEN_SPACE_SHADOWS=0
CS_ORG_SUBSURFACE_SCATTERING=0
CS_ORG_SCREEN_SPACE_GI=0
CS_GRASS_COLLISION_STATS=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;1500:set timescale to 0;1510:tai;1520:fw 81a;2400:dclf:shot=whiterun;2401:dclf:shot=whiterun2;2500:coc WhiterunDragonsreach;3000:set timescale to 0;3010:tai;3600:dclf:shot=dragonsreach;3601:dclf:shot=dragonsreach2
CS_DCLF_TEST_EXIT=3700
