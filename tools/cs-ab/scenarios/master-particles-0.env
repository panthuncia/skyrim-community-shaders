# The baseline for master-particles-1.env: the master particle systems stay the engine's (CS_DCLF_MASTER_PARTICLES unset), the same
# cells, time and shots. The log has no "[DCLF] master particles" lines.
CS_DCLF_STATS=1
CS_DCLF_SET_PARITY=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=300:set gamehour to 22;310:set timescale to 0;320:coc Whiterun;1500:dclf:shot=whiterun-night;1600:coc WhiterunDragonsreach;2500:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=2600
