# latch-census.env with shots right after each load (5.5.1, docs/development/dclf-architecture.md "Load screens"). Each load logs one
# "[DCLF] load hold: N frames, T ms (the loading menu kept open), settled" line (a "released after" warning names what still waited).
# The census's load windows should read no DCLF class (Lighting, Utility depth and shadow, Effect, DistantTree) reaching D3D11, and no
# "[E] [ORG] flush latch: engine ... nobody vouched for it" line names one. The *-first shots, two counted frames after each hold,
# should match the later shot of the same place (no object missing, nothing popping in). Keep the switch lines in step with
# latch-census.env.
# cs-ab: disable-mod=Skyrim Engine Telemetry
CS_ORG_ENGINE_FLUSH_LATCH=1
CS_ORG_RESIDUE_CENSUS=1
CS_ORG_RESIDUE_CENSUS_FRAMES=300
CS_ORG_RESIDUE_CENSUS_TOP=60
CS_ORG_SHADOW_MASK=1
CS_ORG_COMPOSITE=1
CS_ORG_IBL=1
CS_ORG_SCREEN_SPACE_SHADOWS=1
CS_ORG_TERRAIN_SHADOWS=1
CS_ORG_VOLUMETRIC_SHADOWS=1
CS_ORG_SKYLIGHTING=1
CS_ORG_GRASS_COLLISION=1
CS_ORG_LIGHT_LIMIT_FIX_SHADOWS=1
CS_ORG_SCREEN_SPACE_GI=1
CS_ORG_SUBSURFACE_SCATTERING=1
CS_ORG_EXPONENTIAL_HEIGHT_FOG=1
CS_ORG_DYNAMIC_CUBEMAPS=1
CS_ORG_CLOUD_SHADOWS=1
CS_ORG_POST_PROCESSING=1
CS_ORG_HDR_DISPLAY=1
CS_ORG_UPSCALING=1
CS_ORG_SCREENSHOT=1
CS_ORG_TERRAIN_BLENDING=1
CS_ORG_GLINTS=1
CS_ORG_E11_RAYS=1
CS_ORG_IMGUI=1
CS_ORG_TRIPWIRE_GUEST=1
CS_ORG_ENGINE_TARGETS=1
CS_ORG_ENGINE_TARGET_HANDLES=1
CS_ORG_ENGINE_BUFFERS=1
CS_ORG_ENGINE_TEXTURES=1
CS_ORG_ENGINE_SHADERS=1
CS_ORG_TEXTURE_STREAMING=1
CS_ORG_ENGINE_CONSTANTS=1
CS_ORG_ENGINE_SKELETON=1
CS_ORG_SKY=1
CS_ORG_SKY_CLOUDS=0
CS_ORG_WATER=1
CS_ORG_BLOOD_SPLATTER=1
CS_ORG_IMAGESPACE=1
CS_ORG_MENU3D=1
CS_ORG_MAP=1
CS_ORG_SCALEFORM=1
CS_ORG_BINK=1
CS_ORG_LOADING_THREAD=1
CS_ORG_TRIPWIRE_WATCH_ALL=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;700:coc Whiterun;702:dclf:shot=whiterun-first;1300:set timescale to 20;1310:fw 81a;1400:set timescale to 0;1401:set gamehour to 13;1500:dclf:shot=whiterun;1600:dclf:menu=InventoryMenu=show;1800:dclf:shot=inventory;1850:dclf:menu=InventoryMenu=hide;2700:dclf:save=p4tour;2800:dclf:load=recent;2802:dclf:shot=loaded-first;3500:dclf:shot=loaded;3600:cow Blackreach 0 0;3602:dclf:shot=blackreach-first;4400:dclf:shot=blackreach;4500:coc WhiterunDragonsreach;4502:dclf:shot=dragonsreach-first;5300:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=5400
