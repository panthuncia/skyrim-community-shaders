# native.env on BasicRHI's D3D12 backend (CS_ORG_NATIVE_BACKEND=d3d12, org-full-port.md "Phase 7 status"). Read the
# "[ORG native] stage" lines (stage 3 names the D3D12 device), "[ORG] Render graph backend: D3D12", "[ORG] D3D12 device:" for its
# features, "[ORG] DXIL build of" for shaders that do not build to DXIL, and "[DCLF] Forced off" (DCLF is not ported to D3D12, so
# the world's geometry is not drawn). DXVK_DEBUG=hang turns DRED on (its report is logged on device removal).
# cs-ab: disable-mod=Skyrim Engine Telemetry
# cs-ab: disable-mod=ImprovedCameraSE
CS_ORG_NATIVE=1
CS_ORG_NATIVE_BACKEND=d3d12
CS_DISABLE_FEATURES=Upscaling
CS_ORG_TRIPWIRE_LOG=1
CS_ORG_TRIPWIRE_LOG_INTERVAL=20
DXVK_DEBUG=hang
CS_DCLF_TEST_COMMANDS=500:dclf:shot=start;700:coc Whiterun;1900:dclf:shot=whiterun;2300:coc WhiterunDragonsreach;3400:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=3600
CS_ORG_RESIDUE_CENSUS=1
