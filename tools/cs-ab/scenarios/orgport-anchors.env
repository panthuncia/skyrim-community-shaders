# Frame-anchor self-test: every anchor writes and reads back a buffer; an interior for the reflection prepass.
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_ORG_ANCHOR_SELFTEST=1
CS_DCLF_TEST_COMMANDS=300:coc Whiterun;900:dclf:shot;1000:coc WhiterunDragonsreach;1600:dclf:shot
CS_DCLF_TEST_EXIT=1700
