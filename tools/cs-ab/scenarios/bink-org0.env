# Bink on the engine's path (P5.11 baseline): after the save loads, the console plays the startup logo on the main thread
# (dclf:bink, the path the console's PlayBink takes), and decoded frames 40 and 120 are saved as shots/bink-40.png and bink-120.png. The startup logo itself plays on
# the MoviePlayer thread. Compare the shots with bink-org1's.
CS_ORG_BINK_SHOT=40,120
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:dclf:bink=BGS_Logo.bik;700:dclf:shot=after
CS_DCLF_TEST_EXIT=900
