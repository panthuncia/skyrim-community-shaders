# Volumetric Shadows on D3D11 (0) or the render graph (1): Whiterun at a fixed hour in clear weather, then Dragonsreach.
CS_ORG_VOLUMETRIC_SHADOWS=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=300:set timescale to 0;301:set gamehour to 13;302:fw 81a;400:coc Whiterun;1300:fw 81a;1500:dclf:shot=whiterun;1501:dclf:shot=whiterun2;1600:coc WhiterunDragonsreach;2500:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=2600
