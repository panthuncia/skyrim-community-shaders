# sky-river-org1.env with CS_ORG_SKY_CLOUDS=main: only the main view's clouds are the graph's (bisects the faces' occlusion from the main draws).
CS_ORG_SKY_CLOUDS=main
CS_ORG_SKY=1
CS_ORG_CLOUD_SHADOWS=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 12f2d;700:coc Riverwood;1800:set timescale to 0;1810:fw 12f2d;1900:player.setpos x 19300;1901:player.setpos y -45300;1902:player.setpos z -80;1910:player.setangle x 12;1911:player.setangle z 0;2300:dclf:shot=river-noon;2310:player.setangle x -60;2600:dclf:shot=river-sky-noon;2610:player.setangle x 12;2620:set gamehour to 22;2630:fw 12f2d;3000:dclf:shot=river-night;3010:player.setangle x -60;3300:dclf:shot=river-sky-night;3310:coc WhiterunDragonsreach;4300:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=4400
