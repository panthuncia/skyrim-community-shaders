# imagespace-rest-org1.env with the ImageSpace port off: the D3D11 baseline for its shots (the same feature switches).
# cs-ab: disable-mod=Skyrim Engine Telemetry
CS_ORG_IMAGESPACE=0
CS_ORG_ENGINE_CONSTANTS=1
CS_ORG_IBL=1
CS_ORG_EXPONENTIAL_HEIGHT_FOG=1
CS_ORG_DYNAMIC_CUBEMAPS=1
CS_ORG_TRIPWIRE_GUEST=1
CS_ORG_ENGINE_TARGETS=1
CS_ORG_ENGINE_TARGET_HANDLES=1
CS_ORG_ENGINE_TEXTURES=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2410:set gamehour to 23;2800:dclf:shot=whiterun-night;2810:set gamehour to 13;2900:coc WhiterunDragonsreach;4000:dclf:shot=dragonsreach;4100:coc Riverwood;5200:fw 81a;5300:player.setpos x 19300;5301:player.setpos y -45300;5302:player.setpos z -80;5310:player.setangle x 12;5311:player.setangle z 0;5700:dclf:shot=river
CS_DCLF_TEST_EXIT=5800
