# LLF's lights buffer with DCLF off: every lit draw is the engine's and reads t35. Shots in Whiterun and Dragonsreach, a fixed camera.
CS_DCLF=0
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=300:coc Whiterun;1500:dclf:shot=whiterun;1600:coc WhiterunDragonsreach;1700:tfc;2300:player.placeatme 625e0 8;3000:dclf:shot=dragonsreach;3060:dclf:shot=dragonsreach2
CS_DCLF_TEST_EXIT=3150
