# P5.7: every engine constant-buffer use captured into graph memory (CS_ORG_ENGINE_CONSTANTS=1), with the guest handles and
# every P4 engine-resource switch on. The dclf-publish2-0 tour. The log should show "[ORG] engine constants: capturing every
# engine constant-buffer use" and a summary line every 300 frames ("[ORG] engine constants: 300 frames: per frame ..."), with
# uses and copies above zero in Whiterun and Dragonsreach, and no "[ORG] engine constants:" error. Shots must match
# dclf-publish2-0's: the capture only reads.
CS_ORG_ENGINE_CONSTANTS=1
CS_ORG_ENGINE_CONSTANTS_LOG_FRAMES=300
CS_ORG_TRIPWIRE_GUEST=1
CS_ORG_ENGINE_TARGETS=1
CS_ORG_ENGINE_TARGET_HANDLES=1
CS_ORG_ENGINE_BUFFERS=1
CS_ORG_ENGINE_TEXTURES=1
CS_ORG_ENGINE_SHADERS=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2500:coc WhiterunDragonsreach;3600:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=3700
