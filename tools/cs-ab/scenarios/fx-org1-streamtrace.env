# The black-frame experiment: fx-org1 with the in-stream epochs' executions logged ([ORG] stream trace) around the GPU wait at
# frame 1500 (CS_TONEMAP_SYNC_AT) and after the cell change at 2500. Compare the Tonemap epoch's packets (* = kept), slots
# and segments before and after the wait, and after the cell change.
CS_ORG_FX=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2500:coc WhiterunDragonsreach;3600:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=3700
CS_TONEMAP_SYNC_AT=1500
CS_ORG_STREAM_TRACE_AT=1490-1512,2590-2602
