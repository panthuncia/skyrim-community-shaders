# DCLF without the Phase 3-5 graph families: the residue census (CS_ORG_RESIDUE_CENSUS, needs the tripwire guest) and DCLF's
# registration census on the p5-all tour, so the residue's Lighting, Utility, Effect, Particle and DistantTree draws are DCLF's
# alone (the sky, water, ImageSpace, Scaleform and Bink draws are the engine's here by design). Compare with
# p5-all-census-dclf.env: a class only this run has is one a P5 family takes. Keep the commands in step with p5-all-census.env.
CS_ORG_RESIDUE_CENSUS=1
CS_ORG_RESIDUE_CENSUS_FRAMES=300
CS_ORG_RESIDUE_CENSUS_TOP=60
CS_ORG_TRIPWIRE_GUEST=1
CS_DCLF_CENSUS=1
CS_DCLF_STATS=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;700:coc Whiterun;1300:set timescale to 20;1310:fw 81a;1400:set timescale to 0;1401:set gamehour to 13;1500:dclf:shot=whiterun;1501:dclf:vram-json;1502:dclf:tex-stats;1600:dclf:menu=InventoryMenu=show;1800:dclf:shot=inventory;1850:dclf:menu=InventoryMenu=hide;1950:dclf:menu=MapMenu=show;2200:dclf:shot=map;2250:dclf:menu=MapMenu=hide;2350:dclf:menu=Journal Menu=show;2500:dclf:shot=journal;2550:dclf:menu=Journal Menu=hide;2700:dclf:save=p4tour;2800:dclf:load=recent;3500:dclf:shot=loaded;3600:cow Blackreach 0 0;4400:dclf:shot=blackreach;4401:dclf:vram-json;4402:dclf:tex-stats;4500:showracemenu;4750:dclf:shot=racemenu
CS_DCLF_TEST_EXIT=4800
