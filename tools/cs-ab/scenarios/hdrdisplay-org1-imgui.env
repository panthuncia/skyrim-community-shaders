# hdrdisplay-org1 with CS's ImGui on the graph too (CS_ORG_IMGUI=1): the menu is drawn into HDR's UI texture at the Overlay anchor,
# then composed at the HDROutput anchor. Compare with hdrdisplay-org0's shots.
CS_ORG_HDR_DISPLAY=1
CS_ORG_IMGUI=1
CS_ORG_OWNED_FRAME=0
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;1400:fw 81a;1500:dclf:shot=sdr;1550:dclf:hdr=1;1900:dclf:shot=hdr;1950:dclf:cs-menu=open;2250:dclf:shot=hdr-menu;2300:dclf:cs-menu=close;2400:coc WhiterunDragonsreach;3500:dclf:shot=dragonsreach;3550:dclf:hdr=0;3700:dclf:shot=dragonsreach-sdr
CS_DCLF_TEST_EXIT=3800
