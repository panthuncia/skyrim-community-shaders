# The ownership inversion (CS_ORG_OWNED_FRAME=1): BasicRHI's device, DXVK as guest, ORG presents. Whiterun, a loading screen into
# Dragonsreach, the menu, and a shot at each.
CS_ORG_OWNED_FRAME=1
CS_ORG_CRASH_MARKERS=0
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=500:dclf:shot=start;700:coc Whiterun;1900:dclf:shot=whiterun;2300:coc WhiterunDragonsreach;3400:dclf:shot=dragonsreach;3500:dclf:cs-menu=open;3700:dclf:shot=menu;3800:dclf:cs-menu=close
CS_DCLF_TEST_EXIT=3900
