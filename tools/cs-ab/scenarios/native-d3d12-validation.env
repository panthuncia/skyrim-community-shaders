# native-d3d12.env with the D3D12 debug layer (CS_ORG_NATIVE_VALIDATION=1) and GPU-based validation (SARP_D3D12_GPU_VALIDATION=1,
# read by BasicRHI). GPU-based validation is slow: for the start and the first frames only. Debug layer messages go to BasicRHI's
# log lines; a removed device logs the DRED report.
# cs-ab: disable-mod=Skyrim Engine Telemetry
# cs-ab: disable-mod=ImprovedCameraSE
CS_ORG_NATIVE=1
CS_ORG_NATIVE_BACKEND=d3d12
CS_ORG_NATIVE_VALIDATION=1
SARP_D3D12_GPU_VALIDATION=1
CS_DISABLE_FEATURES=Upscaling
CS_ORG_TRIPWIRE_LOG=1
DXVK_DEBUG=hang
CS_DCLF_TEST_COMMANDS=500:dclf:shot=start
CS_DCLF_TEST_EXIT=900
