# Fast iteration on native Vulkan: the autoloaded save, one shot, exit. About a minute with a warm shader cache.
# cs-ab: disable-mod=Skyrim Engine Telemetry
# cs-ab: disable-mod=ImprovedCameraSE
CS_ORG_NATIVE=1
CS_DISABLE_FEATURES=Upscaling
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=150:dclf:shot=start
CS_DCLF_TEST_EXIT=200
