# Bink on the render graph (CS_ORG_BINK=1, P5.11): as bink-org0, with that movie drawn by the Present anchor's
# cs.bink.tiles pass. Expect "[ORG] Bink: ... movie ended: N frames drawn by the render graph, 0 or 1 by the engine" and shots that
# match bink-org0's.
CS_ORG_BINK=1
CS_ORG_BINK_SHOT=40,120
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:dclf:bink=BGS_Logo.bik;700:dclf:shot=after
CS_DCLF_TEST_EXIT=900
