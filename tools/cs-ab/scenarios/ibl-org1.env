# Image Based Lighting on the render graph (CS_ORG_IBL=1), with its SH read back every 250 frames: shots at Whiterun and Dragonsreach.
CS_ORG_IBL=1
CS_ORG_IBL_READBACK=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=300:coc Whiterun;1500:dclf:shot=whiterun;1600:coc WhiterunDragonsreach;2500:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=2600
