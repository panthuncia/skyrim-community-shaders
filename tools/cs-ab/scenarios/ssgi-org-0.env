# Screen Space GI on D3D11 (0) or on the render graph (1), shots at Whiterun and Dragonsreach with time and AI stopped.
CS_ORG_SCREEN_SPACE_GI=0
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=300:coc Whiterun;800:set timescale to 0;820:tai;1500:dclf:shot=whiterun;1600:coc WhiterunDragonsreach;2000:set timescale to 0;2500:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=2600
