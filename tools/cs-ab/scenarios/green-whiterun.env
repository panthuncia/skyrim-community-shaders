# Short Whiterun green-artifact check: latch census (state-reader trace) up to the noon Whiterun shot.
# latch-census.env without Blackreach and the race menu (fewer locations, less VRAM): Whiterun, the inventory, map and journal,
# a save and its load, then Dragonsreach. The Phase 5.5 working census; check with tools/cs-ab/census.py.
# p5-all-census-misc.env with the flush latch on (P5.13, docs/development/p5/flush.md "The latch" and "Allowed engine draws"). Against
# latch-census-off.env: the census's draws should be the same classes (allowed ones still reach D3D11), "[ORG] flush latch: N frames:"
# names the allowed draws by reason, and every "[ORG] flush latch: engine ... nobody vouched for it ... skipped" [E] line is a draw no
# port vouched for. Keep the switch lines in step with p5-all-census-misc.env.
# cs-ab: disable-mod=Skyrim Engine Telemetry
CS_ORG_ENGINE_FLUSH_LATCH=1
CS_ORG_RESIDUE_CENSUS=1
CS_ORG_RESIDUE_CENSUS_FRAMES=300
CS_ORG_RESIDUE_CENSUS_TOP=60
CS_ORG_SHADOW_MASK=1
CS_ORG_COMPOSITE=1
CS_ORG_IBL=1
CS_ORG_SCREEN_SPACE_SHADOWS=1
CS_ORG_TERRAIN_SHADOWS=1
CS_ORG_VOLUMETRIC_SHADOWS=1
CS_ORG_SKYLIGHTING=1
CS_ORG_GRASS_COLLISION=1
CS_ORG_LIGHT_LIMIT_FIX_SHADOWS=1
CS_ORG_SCREEN_SPACE_GI=1
CS_ORG_SUBSURFACE_SCATTERING=1
CS_ORG_EXPONENTIAL_HEIGHT_FOG=1
CS_ORG_DYNAMIC_CUBEMAPS=1
CS_ORG_CLOUD_SHADOWS=1
CS_ORG_POST_PROCESSING=1
CS_ORG_HDR_DISPLAY=1
CS_ORG_UPSCALING=1
CS_ORG_SCREENSHOT=1
CS_ORG_TERRAIN_BLENDING=1
CS_ORG_GLINTS=1
CS_ORG_E11_RAYS=1
CS_ORG_IMGUI=1
CS_ORG_TRIPWIRE_GUEST=1
CS_ORG_ENGINE_TARGETS=1
CS_ORG_ENGINE_TARGET_HANDLES=1
CS_ORG_ENGINE_BUFFERS=1
CS_ORG_ENGINE_TEXTURES=1
CS_ORG_ENGINE_SHADERS=1
CS_ORG_TEXTURE_STREAMING=1
CS_ORG_ENGINE_CONSTANTS=1
CS_ORG_ENGINE_SKELETON=1
CS_ORG_SKY=1
CS_ORG_OCCLUSION_QUERIES=1
CS_ORG_VOLUMETRIC_LIGHTING=1
CS_ORG_WATER=1
CS_ORG_BLOOD_SPLATTER=1
CS_ORG_PRECIPITATION=1
CS_ORG_IMAGESPACE=1
CS_ORG_MENU3D=1
CS_ORG_MAP=1
CS_ORG_SCALEFORM=1
CS_ORG_BINK=1
CS_ORG_LOADING_THREAD=1
CS_ORG_TRIPWIRE_WATCH_ALL=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;700:coc Whiterun;1300:set timescale to 20;1310:dclf:weather=SkyrimClear_A;1400:set timescale to 0;1401:set gamehour to 13;1500:dclf:shot=whiterun
CS_DCLF_TEST_EXIT=1600
