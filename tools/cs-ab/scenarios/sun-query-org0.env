# The D3D11 reference for sun-query-org1.env: the same switches and tour with CS_ORG_OCCLUSION_QUERIES=0 and the flush latch off,
# so D3D11 still draws the sun's occlusion draw and counts it (with the latch on and no vouch left, the latch would skip that draw
# and its query would count nothing). CS_ORG_OCCLUSION_QUERY_LOG=1 hooks the engine's GetQueryData only to log what D3D11 answered:
# '[ORG] occlusion queries: ring slot N read M samples (D3D11's count)'. The census still counts the sun's draw here.
# cs-ab: disable-mod=Skyrim Engine Telemetry
CS_ORG_RESIDUE_CENSUS=1
CS_ORG_RESIDUE_CENSUS_FRAMES=300
CS_ORG_RESIDUE_CENSUS_TOP=60
CS_ORG_SHADOW_MASK=1
CS_ORG_COMPOSITE=1
CS_ORG_IBL=1
CS_ORG_SCREEN_SPACE_SHADOWS=1
CS_ORG_TERRAIN_SHADOWS=1
CS_ORG_VOLUMETRIC_SHADOWS=1
CS_ORG_SKYLIGHTING=1
CS_ORG_GRASS_COLLISION=1
CS_ORG_LIGHT_LIMIT_FIX_SHADOWS=1
CS_ORG_SCREEN_SPACE_GI=1
CS_ORG_SUBSURFACE_SCATTERING=1
CS_ORG_EXPONENTIAL_HEIGHT_FOG=1
CS_ORG_DYNAMIC_CUBEMAPS=1
CS_ORG_CLOUD_SHADOWS=1
CS_ORG_POST_PROCESSING=1
CS_ORG_HDR_DISPLAY=1
CS_ORG_UPSCALING=1
CS_ORG_SCREENSHOT=1
CS_ORG_TERRAIN_BLENDING=1
CS_ORG_GLINTS=1
CS_ORG_E11_RAYS=1
CS_ORG_IMGUI=1
CS_ORG_TRIPWIRE_GUEST=1
CS_ORG_ENGINE_TARGETS=1
CS_ORG_ENGINE_TARGET_HANDLES=1
CS_ORG_ENGINE_BUFFERS=1
CS_ORG_ENGINE_TEXTURES=1
CS_ORG_ENGINE_SHADERS=1
CS_ORG_TEXTURE_STREAMING=1
CS_ORG_ENGINE_CONSTANTS=1
CS_ORG_ENGINE_SKELETON=1
CS_ORG_SKY=1
CS_ORG_SKY_CLOUDS=0
CS_ORG_WATER=1
CS_ORG_BLOOD_SPLATTER=1
CS_ORG_IMAGESPACE=1
CS_ORG_MENU3D=1
CS_ORG_MAP=1
CS_ORG_SCALEFORM=1
CS_ORG_BINK=1
CS_ORG_LOADING_THREAD=1
CS_ORG_TRIPWIRE_WATCH_ALL=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_ORG_OCCLUSION_QUERIES=0
CS_ORG_ENGINE_FLUSH_LATCH=0
CS_ORG_OCCLUSION_QUERY_LOG=1
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 16;602:fw 81a;700:coc Whiterun;1800:fw 81a;1900:player.setangle x -20;1901:player.setangle z 240;2200:dclf:shot=sun-240;2210:player.setangle z 200;2500:dclf:shot=sun-200;2510:player.setangle z 280;2800:dclf:shot=sun-280;2810:player.setangle z 60;3100:dclf:shot=sun-away;3110:player.setangle x -60;3111:player.setangle z 240;3400:dclf:shot=sun-high;3410:coc WhiterunDragonsreach;4200:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=4300
