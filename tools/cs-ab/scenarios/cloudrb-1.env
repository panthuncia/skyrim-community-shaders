# Cloud Shadows readback: per-face means of the last layer and the bound occlusion every 250 frames, D3D11 (0) or the graph (1).
CS_ORG_CLOUD_SHADOWS=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=400:coc Whiterun;1300:set timescale to 0;1310:set gamehour to 13;1320:fw 12f2d;2000:dclf:shot=clouds1;2300:dclf:shot=clouds2
CS_DCLF_TEST_EXIT=2400
CS_CLOUD_READBACK=1
