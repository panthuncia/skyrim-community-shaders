# As upscaling-org1.env, with FSR frame generation switched on after the Whiterun shot: the hudless copy (the FrameGeneration
# anchor with CS_ORG_UPSCALING=1). Same SettingsUser.json upscaler setting.
CS_ORG_UPSCALING=1
CS_UPSCALE_UNFOCUSED=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2450:dclf:fg=fsr;2900:dclf:shot=whiterun-fg;3000:coc WhiterunDragonsreach;4100:dclf:shot=dragonsreach-fg;4150:dclf:fg=off
CS_DCLF_TEST_EXIT=4300
