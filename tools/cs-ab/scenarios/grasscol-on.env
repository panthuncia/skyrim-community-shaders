# Grass Collision A/B (CS_ORG_GRASS_COLLISION=1): the player standing in the tundra around Whiterun's walls (coc Whiterun lands
# inside them). Four candidate cells, one shot each: pixel-diff each shot against grasscol-off's, using the cells where the
# player stands in grass. CS_GRASS_COLLISION_STATS logs "[GRASS COLLISION] frame N (D3D11|ORG): X colliders, Y collision shapes".
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_GRASS_COLLISION_STATS=1
CS_ORG_GRASS_COLLISION=1
CS_DCLF_TEST_COMMANDS=300:cow Tamriel 3 -4;900:dclf:shot=t3m4;1000:cow Tamriel 5 -5;1600:dclf:shot=t5m5;1700:cow Tamriel 7 -4;2300:dclf:shot=t7m4;2400:cow Tamriel 4 -1;3000:dclf:shot=t4m1
CS_DCLF_TEST_EXIT=3100
