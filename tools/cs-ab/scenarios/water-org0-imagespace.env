# water-org0.env with the ImageSpace port and the engine targets on, which publish the refraction copy and the SSR targets the
# water samples (the residue census's RT kRAW_WATER and RT kMAIN Water classes). The baseline for water-org1-imagespace.env.
CS_ORG_LIGHT_LIMIT_FIX_SHADOWS=1
CS_ORG_TRIPWIRE_GUEST=1
CS_ORG_ENGINE_TARGETS=1
CS_ORG_ENGINE_TARGET_HANDLES=1
CS_ORG_ENGINE_TEXTURES=1
CS_ORG_ENGINE_CONSTANTS=1
CS_ORG_IMAGESPACE=1
CS_ORG_RESIDUE_CENSUS=1
CS_ORG_RESIDUE_CENSUS_FRAMES=300
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Riverwood;1800:set timescale to 0;1810:fw 81a;1900:player.setpos x 19300;1901:player.setpos y -45300;1902:player.setpos z -80;1910:player.setangle x 12;1911:player.setangle z 0;2300:dclf:shot=river-clear;2310:fw c821f;2900:dclf:shot=river-rain;2910:player.setpos x 19400;2911:player.setpos y -43300;2912:player.setpos z -420;2920:player.setangle x 0;3300:dclf:shot=underwater;3310:fw 81a;3320:player.setpos z -80;3330:player.setpos y -45300;3340:coc WhiterunDragonsreach;4300:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=4400
