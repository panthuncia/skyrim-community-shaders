# The screen blood family on (CS_ORG_BLOOD_SPLATTER=1): BSBloodSplatterShader's splatter and flare drawn into the back buffer at the
# EngineDraws anchor, against blood-org0.env.
# Riverwood, first person, one melee bandit (1bcd8: EncBandit01Melee1HNordM) placed at the player, whose health is raised; the
# splatters are made to last (fBloodSplatterDuration and FadeStart 1000 s). After about 8 s of the fight every actor's AI is turned
# off (tai) and the camera looks straight down at the ground (static), so only the splatters differ between runs: their placement
# and count are the engine's random draws, so compare their look (colour, multiply, flare), not their pixels. Then third person
# for a shot of the frozen scene without the first-person splatters (if the engine still draws them there, they show too).
CS_ORG_BLOOD_SPLATTER=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Riverwood;1800:set timescale to 0;1801:setgs fBloodSplatterDuration 1000;1802:setgs fBloodSplatterFadeStart 1000;1810:dclf:pov=first;1820:player.setav health 100000;1830:player.placeatme 1bcd8 1;2300:tai;2310:player.setangle x 80;2311:player.setangle z 0;2500:dclf:shot=blood1;2600:dclf:shot=blood2;2700:dclf:pov=third;2800:dclf:shot=noblood
CS_DCLF_TEST_EXIT=2900
