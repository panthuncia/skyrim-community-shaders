# The screen blood family on (CS_ORG_BLOOD_SPLATTER=1): BSBloodSplatterShader's splatter and flare drawn into the back buffer at the
# EngineDraws anchor, against blood-org0.env. Riverwood, first person, three melee bandits (1bcd8: EncBandit01Melee1HNordM) placed at
# the player, whose health is raised so the fight lasts; five shots while they hit. Screen blood comes from hits taken in first
# person: compare the shots' red splatters (their placement differs between runs, their look should not).
CS_ORG_BLOOD_SPLATTER=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Riverwood;1800:set timescale to 0;1810:dclf:pov=first;1820:player.setav health 100000;1830:player.placeatme 1bcd8 3;2300:dclf:shot=blood1;2400:dclf:shot=blood2;2500:dclf:shot=blood3;2600:dclf:shot=blood4;2700:dclf:shot=blood5
CS_DCLF_TEST_EXIT=2800
