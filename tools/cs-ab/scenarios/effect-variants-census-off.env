# effect-variants-census.env with the two ported effect variants left to the engine (the "before" census): cloud-lit effects
# (CS_DCLF_EFFECT_CLOUD_LIGHT=0, class effect-variant (cloud-lighting)) and unblended Falloff effects (CS_DCLF_EFFECT_FALLOFF=0,
# class effect-opaque).
CS_DCLF_EFFECT_CLOUD_LIGHT=0
CS_DCLF_EFFECT_FALLOFF=0
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_CENSUS=1
CS_DCLF_STATS=1
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;700:coc Whiterun;1500:dclf:mark=whiterun;2400:dclf:shot=ev-whiterun;2500:coc Riverwood;1801:fw 81a;3300:dclf:mark=riverwood;4200:dclf:shot=ev-riverwood;4300:coc WhiterunDragonsreach;5100:dclf:mark=dragonsreach;6000:dclf:shot=ev-dragonsreach
CS_DCLF_TEST_TURN=1500:2300:0.25
CS_DCLF_TEST_EXIT=6100
