# P1.6: the CS menu over Whiterun with CS_ORG_IMGUI=1 (1: ImGui drawn by the render graph's backend at the Overlay anchor). Compare
# the two runs' menu shots: fonts, icons, colours and scissoring must match.
CS_ORG_IMGUI=1
CS_ORG_OWNED_FRAME=0
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=300:coc Whiterun;1500:dclf:shot=whiterun;1600:dclf:cs-menu=open;1900:dclf:shot=menu;2000:dclf:shot=menu2;2100:dclf:cs-menu=close;2200:dclf:shot=closed
CS_DCLF_TEST_EXIT=2300
