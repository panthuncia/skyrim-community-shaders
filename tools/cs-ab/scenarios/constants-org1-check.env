# constants-org1.env plus CS_ORG_ENGINE_CONSTANTS_CHECK=1: about once a second one captured slot is compared with a staging
# read-back of its D3D11 buffer (stalls; not for timing). The summary lines end with "checked N, 0 differ"; any
# "[ORG] engine constants check: ... differs" line names the stage, slot and engine group that came out wrong.
CS_ORG_ENGINE_CONSTANTS=1
CS_ORG_ENGINE_CONSTANTS_CHECK=1
CS_ORG_ENGINE_CONSTANTS_LOG_FRAMES=300
CS_ORG_TRIPWIRE_GUEST=1
CS_ORG_ENGINE_TARGETS=1
CS_ORG_ENGINE_TARGET_HANDLES=1
CS_ORG_ENGINE_BUFFERS=1
CS_ORG_ENGINE_TEXTURES=1
CS_ORG_ENGINE_SHADERS=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2500:coc WhiterunDragonsreach;3600:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=3700
