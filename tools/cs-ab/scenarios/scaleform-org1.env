# Scaleform on the render graph (P5.10, docs/development/p5/scaleform.md): scaleform-org0.env's tour with CS_ORG_SCALEFORM=1.
# The log should show "[ORG] Scaleform: drawing displays on the render graph", "GFx's textures are made on ORG", each reason the
# D3D11 renderer drew a part once ("the D3D11 renderer draws: ..."), and a census line every 1000 displays:
# "[ORG] Scaleform census: N displays: G on the graph, M on the graph with D3D11 parts, D on D3D11; ...; D3D11 parts: ...".
# No "a texture's view cannot be resolved". The shots should match scaleform-org0's.
CS_ORG_SCALEFORM=1
CS_ORG_LOADING_THREAD=1
CS_ORG_TRIPWIRE_GUEST=1
CS_ORG_ENGINE_TARGETS=1
CS_ORG_ENGINE_TARGET_HANDLES=1
CS_ORG_ENGINE_BUFFERS=1
CS_ORG_ENGINE_TEXTURES=1
CS_ORG_ENGINE_SHADERS=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=400:dclf:shot=mainmenu;600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;730:dclf:shot=loading;2000:fw 81a;2400:dclf:shot=hud;2500:dclf:menu=InventoryMenu=show;2800:dclf:shot=inventory;2900:dclf:menu=InventoryMenu=hide;3000:dclf:menu=MagicMenu=show;3300:dclf:shot=magic;3400:dclf:menu=MagicMenu=hide;3500:dclf:menu=MapMenu=show;3900:dclf:shot=map;4000:dclf:menu=MapMenu=hide;4200:dclf:menu=Journal Menu=show;4500:dclf:shot=journal;4600:dclf:menu=Journal Menu=hide;4800:dclf:shot=hud-after
CS_DCLF_TEST_EXIT=4900
