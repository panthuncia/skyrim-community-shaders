# Scaleform on the render graph (P5.10, docs/development/p5/scaleform.md), with the tripwire guest and the P4 engine switches: the
# tour of scaleform-org0.env. The log should show "[ORG] Scaleform: drawing displays on the render graph", the reasons displays
# went to D3D11 (each once), and the counts every 1000 displays; the shots should match scaleform-org0's.
CS_ORG_SCALEFORM=1
CS_ORG_TRIPWIRE_GUEST=1
CS_ORG_ENGINE_TARGETS=1
CS_ORG_ENGINE_TARGET_HANDLES=1
CS_ORG_ENGINE_BUFFERS=1
CS_ORG_ENGINE_TEXTURES=1
CS_ORG_ENGINE_SHADERS=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=hud;2500:dclf:menu=InventoryMenu=show;2800:dclf:shot=inventory;2900:dclf:menu=InventoryMenu=hide;3100:dclf:menu=MapMenu=show;3500:dclf:shot=map;3600:dclf:menu=MapMenu=hide;3800:dclf:menu=Journal Menu=show;4100:dclf:shot=journal;4200:dclf:menu=Journal Menu=hide;4400:dclf:shot=hud-after
CS_DCLF_TEST_EXIT=4500
