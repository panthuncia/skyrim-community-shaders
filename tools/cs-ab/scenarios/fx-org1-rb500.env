# fx-org1 (the ORG FX runtime, no FX readback plan) with the tonemap readbacks (CS_TONEMAP_INPUT_READBACK=1): every 500
# frames the tonemap input before the Tonemap anchor, then the input, output and kMAIN_COPY after its epoch, and the output
# after Effects11 ("[Hooks] tonemap ..."). Needs the Rudy ENB preset (org-fx-runtime.md, "Testing").
CS_ORG_FX=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2500:coc WhiterunDragonsreach;3600:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=3700
CS_TONEMAP_INPUT_READBACK=1
CS_TONEMAP_READBACK_AT=500
