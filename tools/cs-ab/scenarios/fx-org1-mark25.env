# Effects11's preset on FX11 (0) or the ORG FX runtime (1), for a screenshot A/B. Needs a preset with readable .fx files in the
# active enbseries folder (Rudy ENB for Obsidian Weathers: org-fx-runtime.md, "Testing") and UseEffect=true. Look for
# "[ORG] Effects11 runs on the render graph" (1) and no "[ORG] Effects11 runs on FX11" lines.
# Whiterun at 13:00 in clear weather, then Dragonsreach, a shot of each.
CS_ORG_FX=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2500:coc WhiterunDragonsreach;3600:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=3700
CS_IS_TRACE_AT=1500
CS_TONEMAP_LATE_READ_AT=1500
CS_TONEMAP_MARK=1
CS_TONEMAP_MARK_TARGETS=25
