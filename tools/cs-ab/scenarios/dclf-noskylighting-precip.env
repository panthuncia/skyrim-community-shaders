# The precipitation mask without Skylighting (CS_DISABLE_FEATURES): DCLF draws it in its shadow epoch through its own hook of the engine's
# mask (dclf-architecture.md, "The occlusion maps, drawn by DCLF", "The mask without Skylighting"). Whiterun in rain (fw 10a241) at midday,
# with the mask's parity on (every 120th frame the engine's mask and DCLF's, texel by texel); a shot with DCLF's mask, then with the
# engine's (dclf:precipitation occlusion=0), then Dragonsreach (an interior: no mask, nothing drawn for it).
# Compare: the two Whiterun shots match (rain stops under the same roofs and overhangs; wet surfaces the same under cover).
# Log: "precipitation mask hook installed on Main::Draw (without Skylighting)", "Feature 'Skylighting' is disabled at boot by
# CS_DISABLE_FEATURES", "[DCLF] precipitation occlusion parity: ... DCLF farther 0" in Whiterun (nearer only while roots fade in), no
# "sky occlusion parity" line, no [E] but EFFECTS11's.
CS_DISABLE_FEATURES=Skylighting
CS_DCLF_SKYLIGHT_PARITY=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=300:set timescale to 0;301:set gamehour to 13;302:fw 10a241;400:coc Whiterun;1300:set timescale to 0;1310:fw 10a241;1320:tai;2000:dclf:shot=rain;2020:dclf:precipitation occlusion=0;2300:dclf:shot=rain-engine;2320:dclf:precipitation occlusion=1;2400:coc WhiterunDragonsreach;3200:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=3300
