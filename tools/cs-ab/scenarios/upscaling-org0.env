# Upscaling's own passes on D3D11 (0) or the render graph (1, CS_ORG_UPSCALING): the copy of the upscaled colour into kMAIN
# and the depth upscale. Needs an upscaler in SettingsUser.json ("Upscaling": "upscaleMethod": 2 for FSR or 4 for XeSS,
# "qualityMode": 1), else only TAA runs. Whiterun at 13:00 in clear weather, then Dragonsreach, a shot of each.
CS_ORG_UPSCALING=0
CS_UPSCALE_UNFOCUSED=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2500:coc WhiterunDragonsreach;3600:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=3700
