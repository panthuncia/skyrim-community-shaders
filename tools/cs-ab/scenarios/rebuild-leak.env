# Graph rebuilds every 10 frames for 2000 frames in Whiterun: device-local usage before (1400) and after (3900). A rising
# localMiB in CS-AB-memory.csv while nothing else changes means rebuilds do not free their memory.
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;700:coc Whiterun;1400:dclf:vram-json;1401:dclf:mark=rebuilds;1410:dclf:rebuild;1420:dclf:rebuild;1430:dclf:rebuild;1440:dclf:rebuild;1450:dclf:rebuild;1460:dclf:rebuild;1470:dclf:rebuild;1480:dclf:rebuild;1490:dclf:rebuild;1500:dclf:rebuild;1510:dclf:rebuild;1520:dclf:rebuild;1530:dclf:rebuild;1540:dclf:rebuild;1550:dclf:rebuild;1560:dclf:rebuild;1570:dclf:rebuild;1580:dclf:rebuild;1590:dclf:rebuild;1600:dclf:rebuild;1610:dclf:rebuild;1620:dclf:rebuild;1630:dclf:rebuild;1640:dclf:rebuild;1650:dclf:rebuild;1660:dclf:rebuild;1670:dclf:rebuild;1680:dclf:rebuild;1690:dclf:rebuild;1700:dclf:rebuild;1710:dclf:rebuild;1720:dclf:rebuild;1730:dclf:rebuild;1740:dclf:rebuild;1750:dclf:rebuild;1760:dclf:rebuild;1770:dclf:rebuild;1780:dclf:rebuild;1790:dclf:rebuild;1800:dclf:rebuild;1810:dclf:rebuild;1820:dclf:rebuild;1830:dclf:rebuild;1840:dclf:rebuild;1850:dclf:rebuild;1860:dclf:rebuild;1870:dclf:rebuild;1880:dclf:rebuild;1890:dclf:rebuild;1900:dclf:rebuild;1910:dclf:rebuild;1920:dclf:rebuild;1930:dclf:rebuild;1940:dclf:rebuild;1950:dclf:rebuild;1960:dclf:rebuild;1970:dclf:rebuild;1980:dclf:rebuild;1990:dclf:rebuild;2000:dclf:rebuild;2010:dclf:rebuild;2020:dclf:rebuild;2030:dclf:rebuild;2040:dclf:rebuild;2050:dclf:rebuild;2060:dclf:rebuild;2070:dclf:rebuild;2080:dclf:rebuild;2090:dclf:rebuild;2100:dclf:rebuild;2110:dclf:rebuild;2120:dclf:rebuild;2130:dclf:rebuild;2140:dclf:rebuild;2150:dclf:rebuild;2160:dclf:rebuild;2170:dclf:rebuild;2180:dclf:rebuild;2190:dclf:rebuild;2200:dclf:rebuild;2210:dclf:rebuild;2220:dclf:rebuild;2230:dclf:rebuild;2240:dclf:rebuild;2250:dclf:rebuild;2260:dclf:rebuild;2270:dclf:rebuild;2280:dclf:rebuild;2290:dclf:rebuild;2300:dclf:rebuild;2310:dclf:rebuild;2320:dclf:rebuild;2330:dclf:rebuild;2340:dclf:rebuild;2350:dclf:rebuild;2360:dclf:rebuild;2370:dclf:rebuild;2380:dclf:rebuild;2390:dclf:rebuild;2400:dclf:rebuild;2410:dclf:rebuild;2420:dclf:rebuild;2430:dclf:rebuild;2440:dclf:rebuild