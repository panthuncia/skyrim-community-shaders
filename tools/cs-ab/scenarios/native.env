# Native mode (CS_ORG_NATIVE=1, render-graph.md "Native mode"): no DXVK, BasicRHI's device, ORG presents. Native mode turns on
# every port switch itself. Upscaling needs DXVK, so it is disabled for the run. Read the "[ORG native] stage" lines for how far
# the start got, and "[ORG native] ... calls" and "[ORG] tripwire:" lines for what still calls D3D11. A main menu shot, then
# Whiterun and Dragonsreach.
# cs-ab: disable-mod=Skyrim Engine Telemetry
CS_ORG_NATIVE=1
CS_DISABLE_FEATURES=Upscaling
CS_ORG_TRIPWIRE_LOG=1
CS_ORG_TRIPWIRE_LOG_INTERVAL=20
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=500:dclf:shot=start;700:coc Whiterun;1900:dclf:shot=whiterun;2300:coc WhiterunDragonsreach;3400:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=3600
