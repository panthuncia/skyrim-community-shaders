# The reference for is-sources-1.env: vanilla's DXBC for every image-space shader CS_IMAGESPACE_SOURCES can enable.
# Shots that run image-space work: a day exterior (HDR, bloom, SAO), the same exterior at night, the world map, an interior
# and water at Riverwood (water displacement). Underwater is not scripted: no checked position below the water there.
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2410:set gamehour to 23;2800:dclf:shot=whiterun-night;2810:set gamehour to 13;2900:dclf:menu=MapMenu=show;3300:dclf:shot=map;3310:dclf:menu=MapMenu=hide;3400:coc WhiterunDragonsreach;4500:dclf:shot=dragonsreach;4600:coc Riverwood;5700:fw 81a;6000:dclf:shot=riverwood
CS_DCLF_TEST_EXIT=6100
