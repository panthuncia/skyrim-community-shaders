# Terrain Shadows on its D3D11 path (0) or the render graph (1, CS_ORG_TERRAIN_SHADOWS): outside Whiterun's walls, time frozen,
# clear weather, a shot at 17:00 and one at 9:00 (each time change refreshes the whole shadow map).
CS_ORG_TERRAIN_SHADOWS=0
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=400:cow Tamriel 5 -3;1300:set timescale to 0;1310:fw 81a;1320:set gamehour to 17;1800:dclf:shot=ts17;1850:set gamehour to 9;2300:dclf:shot=ts9
CS_DCLF_TEST_EXIT=2400
