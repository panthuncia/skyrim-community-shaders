# VRAM Budget exterior stress: the W1-W2 graph ports on to raise VRAM use, then exterior hops through cells with NPCs.
# Run with VRAM Budget's threshold at 50 %; expect only 'unloaded N cells' steps, every [VRAM Budget] line on the main thread, no crash.
CS_ORG_SCREEN_SPACE_SHADOWS=1
CS_ORG_LIGHT_LIMIT_FIX_SHADOWS=1
CS_ORG_GRASS_COLLISION=1
CS_ORG_SKYLIGHTING=1
CS_ORG_IBL=1
CS_ORG_DYNAMIC_CUBEMAPS=1
CS_ORG_TERRAIN_BLENDING=1
CS_ORG_E11_RAYS=1
CS_ORG_EXPONENTIAL_HEIGHT_FOG=1
CS_ORG_TERRAIN_SHADOWS=1
CS_ORG_VOLUMETRIC_SHADOWS=1
CS_ORG_CLOUD_SHADOWS=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=300:cow Tamriel 3 -4;900:dclf:shot=t3m4;1000:coc Riverwood;1800:dclf:shot=riverwood;1900:cow Tamriel 5 -5;2500:cow Tamriel 7 -4;3100:coc Riverwood;3700:cow Tamriel 4 -1;4300:dclf:shot=t4m1
CS_DCLF_TEST_EXIT=4400
