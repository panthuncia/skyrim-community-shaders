# Membrane effects (dclf-roadmap.md 4.1, not ported): the player in third person with Oakflesh (5ad5c) cast on itself, whose effect
# shader puts a membrane pass on the body. The census names the class the membrane pass lands in ("[DCLF] census class ...",
# top geometries the player's body parts); shots of the glow at the newest save.
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_CENSUS=1
CS_DCLF_STATS=1
CS_DCLF_TEST_COMMANDS=300:dclf:pov=third;400:player.cast 5ad5c player;700:dclf:shot=membrane1;1000:player.cast 5ad5c player;1100:dclf:shot=membrane2
CS_DCLF_TEST_EXIT=1300
