# Cloud Shadows on the render graph with Exponential Height Fog on the graph too: the fog reads CloudShadows::Occlusion by name.
# Needs the volumetric fog on in SettingsUser.json (see expfog-org1.env). Same route and weather as cloudshadows-org0/1.env.
CS_ORG_CLOUD_SHADOWS=1
CS_ORG_EXPONENTIAL_HEIGHT_FOG=1
CS_ORG_IBL=1
CS_ORG_SKYLIGHTING=1
CS_ORG_TERRAIN_SHADOWS=1
CS_ORG_LLF_SHADOWS=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=400:cow Tamriel 5 -3;1300:set timescale to 0;1310:set gamehour to 13;1320:fw 12f2d;2000:dclf:shot=clouds1;2300:dclf:shot=clouds2
CS_DCLF_TEST_EXIT=2400
