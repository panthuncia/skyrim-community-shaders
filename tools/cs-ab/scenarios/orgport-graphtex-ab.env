# DCLF frame graph textures: t30 through the graph texture test, graph and D3D11 paths in one run (live toggle), each scene's shots
# taken graph, D3D11, graph again; the two graph shots give the noise between frames.
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_GRAPH_TEXTURE_TEST=graph
CS_DCLF_TEST_COMMANDS=300:coc Whiterun;1500:dclf:shot=gt-wr-graph-a;1501:dclf:graph texture test=0;1600:dclf:shot=gt-wr-d3d11;1601:dclf:graph texture test=1;1700:dclf:shot=gt-wr-graph-b;1800:coc WhiterunDragonsreach;2700:dclf:shot=gt-dr-graph-a;2701:dclf:graph texture test=0;2800:dclf:shot=gt-dr-d3d11;2801:dclf:graph texture test=1;2900:dclf:shot=gt-dr-graph-b
CS_DCLF_TEST_EXIT=3000
