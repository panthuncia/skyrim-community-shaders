# Engine textures on D3D11 (0) or on render graph images (1): Whiterun at 13:00 in clear weather, then Dragonsreach, a shot of
# each, then a worldspace change and a shot there. With 1 the log should show "[ORG] engine textures: on" and no error lines.
CS_ORG_ENGINE_TEXTURES=0
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2500:coc WhiterunDragonsreach;3600:dclf:shot=dragonsreach;3700:cow Blackreach 0 0;4800:dclf:shot=blackreach
CS_DCLF_TEST_EXIT=4900
