# tex-org.env's commands with D3D11 windows and DXVK's VRAM reports: the baseline for it.
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=300:coc Whiterun;1100:dclf:shot=load;1500:dclf:tex-stats;2000:dclf:tex-stats;2001:dclf:shot=whiterun;2002:dclf:vram-json;2100:dclf:tex-force=0;2600:dclf:tex-stats;2601:dclf:shot=forced;2602:dclf:vram-json;2700:dclf:tex-force=-1;3200:dclf:tex-stats;3300:coc WhiterunDragonsreach;4200:dclf:shot=dragonsreach;4201:dclf:tex-stats;4202:dclf:vram-json
CS_DCLF_TEST_EXIT=4300
