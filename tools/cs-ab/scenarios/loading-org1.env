# P5.12 (docs/development/p5/loading-screen.md): loading-org0's tour with CS_ORG_LOADING_THREAD=1, so the loading loop and the
# startup logo render on the graph. Expect "[ORG] render ownership: ... takes it from thread ..." at the logo and at each load,
# "[ORG] loading screen: the load ended", Bink's logo "movie ended" line with nearly every frame drawn by the render graph, no
# "UploadInstance ... called off the owner thread" or "PublishedResources used on thread" line, and shots equal to loading-org0's.
CS_ORG_LOADING_THREAD=1
CS_ORG_TRIPWIRE_GUEST=1
CS_ORG_ENGINE_TARGETS=1
CS_ORG_ENGINE_TARGET_HANDLES=1
CS_ORG_ENGINE_BUFFERS=1
CS_ORG_ENGINE_TEXTURES=1
CS_ORG_ENGINE_SHADERS=1
CS_ORG_TEXTURE_STREAMING=1
CS_ORG_SCALEFORM=1
CS_ORG_BINK=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;700:coc Whiterun;1300:set timescale to 20;1310:fw 81a;1400:set timescale to 0;1401:set gamehour to 13;1500:dclf:shot=whiterun;1600:coc WhiterunDragonsreach;2400:dclf:shot=dragonsreach;2500:cow Blackreach 0 0;3300:dclf:shot=blackreach;3400:dclf:load=recent;4200:dclf:shot=loaded;4201:dclf:tex-stats
CS_DCLF_TEST_EXIT=4300
