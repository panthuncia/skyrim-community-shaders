# P5.6 wave 3 / P5.13: what of the engine's ImageSpace work still reaches D3D11 with CS_ORG_IMAGESPACE=1. The tour of
# imagespace-sao-ssr-org1.env with the residual engine-draw census (docs/development/p5/flush.md), which needs the tripwire
# guest. Read the "[ORG] residue census:" lines: the ImageSpace classes through 107733 (the SAO chain but its composite, the
# reflection downsample and ray march), the dispatches 107734 <- 107209/107210 <- 107207 (the reflection blur), and since
# w3-slots the draws 107732 <- 99023 (the distant blur or depth of field, refraction, the radial blur) and the dispatches
# 107734 <- 107209 <- 107208 (the depth-of-field blur) and 107734 <- 107217 (ISCopySubRegionCS) should be gone; what stays is
# listed in docs/development/p5/imagespace.md ("What is left"). Compare with imagespace-census-org0.env.
CS_ORG_RESIDUE_CENSUS=1
CS_ORG_RESIDUE_CENSUS_FRAMES=300
CS_ORG_RESIDUE_CENSUS_TOP=60
CS_ORG_TRIPWIRE_GUEST=1
CS_ORG_ENGINE_CONSTANTS=1
CS_ORG_IMAGESPACE=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2900:coc WhiterunDragonsreach;4000:dclf:shot=dragonsreach;4100:coc Riverwood;5200:fw 81a;5500:dclf:shot=riverwood
CS_DCLF_TEST_EXIT=5600
