# pp-bloom-org1 with the tonemap readbacks (CS_TONEMAP_INPUT_READBACK=1): every 500 frames the log shows the tonemap input
# before the Tonemap anchor, the input, output and kMAIN_COPY after the anchor's epoch, and the output after the vanilla
# tonemap ("[Hooks] tonemap ..."). A scene before the anchor and ~0 after it: the chain's graph passes write black. A scene
# after the anchor and ~0 after the vanilla tonemap: the chain's output is fine and the passthrough reads something else.
CS_ORG_POST_PROCESSING=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2500:coc WhiterunDragonsreach;3600:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=3700
CS_PP_ONLY=COD Bloom,Composite
CS_TONEMAP_INPUT_READBACK=1
