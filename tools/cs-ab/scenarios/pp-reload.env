# Hot reload on the graph path: the feature's pipelines built from one shader file are checked and swapped if changed; the shots before and after must match.
CS_ORG_POST_PROCESSING=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=before;2450:dclf:reload-shaders=PostProcessing/copy.ps.hlsl;2451:dclf:wait=reload;2600:dclf:shot=after
CS_DCLF_TEST_EXIT=2700
