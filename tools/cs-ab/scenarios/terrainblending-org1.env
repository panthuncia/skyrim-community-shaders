# Terrain Blending's depth blend on D3D11 (0) or the render graph (1, CS_ORG_TERRAIN_BLENDING). Whiterun's outskirts at 13:00 in
# clear weather, where terrain meets rocks and the road (the blend's soft edges), then Dragonsreach.
CS_ORG_TERRAIN_BLENDING=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2500:coc WhiterunDragonsreach;3600:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=3700
