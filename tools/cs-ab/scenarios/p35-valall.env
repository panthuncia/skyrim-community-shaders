# Phase 3.5 validation: every W1-W2 port, Terrain Blending and the rays on the graph with recording reuse on, core validation, errors only.
CS_ORG_SCREEN_SPACE_SHADOWS=1
CS_ORG_LIGHT_LIMIT_FIX_SHADOWS=1
CS_ORG_GRASS_COLLISION=1
CS_ORG_SKYLIGHTING=1
CS_ORG_IBL=1
CS_ORG_DYNAMIC_CUBEMAPS=1
CS_ORG_TERRAIN_BLENDING=1
CS_ORG_E11_RAYS=1
CS_ORG_EXPONENTIAL_HEIGHT_FOG=1
CS_ORG_TERRAIN_SHADOWS=1
CS_ORG_VOLUMETRIC_SHADOWS=1
CS_ORG_CLOUD_SHADOWS=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_ORG_POST_PROCESSING=1
VK_LOADER_LAYERS_ENABLE=*validation
VK_LAYER_DEBUG_ACTION=VK_DBG_LAYER_ACTION_LOG_MSG
VK_LAYER_LOG_FILENAME=C:\Modding\CS-AB\vk-valall-p35.txt
VK_KHRONOS_VALIDATION_DUPLICATE_MESSAGE_LIMIT=1000000
VK_KHRONOS_VALIDATION_REPORT_FLAGS=error
CS_DCLF_TEST_COMMANDS=300:coc Whiterun;1000:dclf:shot=whiterun;1100:coc WhiterunDragonsreach;1700:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=1800
