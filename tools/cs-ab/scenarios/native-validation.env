# native.env with BasicRHI's Vulkan validation on (P6.4): Whiterun, the inventory and the map, a save and its load, then
# Dragonsreach, a shot at each, exit at frame 3600. Validation is slow: frame counts are frames, not seconds. Read the validation
# messages (BasicRHI logs them) and the "[ORG native]" lines.
# cs-ab: disable-mod=Skyrim Engine Telemetry
# cs-ab: disable-mod=ImprovedCameraSE
CS_ORG_NATIVE=1
CS_ORG_NATIVE_VALIDATION=1
CS_DISABLE_FEATURES=Upscaling
CS_ORG_TRIPWIRE_LOG=1
CS_ORG_RESIDUE_CENSUS=1
CS_ORG_RESIDUE_CENSUS_FRAMES=300
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=500:dclf:shot=start;600:set timescale to 0;601:set gamehour to 13;700:coc Whiterun;1300:dclf:shot=whiterun;1400:dclf:menu=InventoryMenu=show;1600:dclf:shot=inventory;1650:dclf:menu=InventoryMenu=hide;1750:dclf:menu=MapMenu=show;1950:dclf:shot=map;2000:dclf:menu=MapMenu=hide;2100:dclf:save=nativetour;2200:dclf:load=recent;2800:dclf:shot=loaded;2900:coc WhiterunDragonsreach;3500:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=3600
