# The shadow mask family's baseline (CS_ORG_SHADOW_MASK off): the engine draws every shadow mask pass into kSHADOW_MASK. Whiterun at
# 13:00 (the sun's cascades), Dragonsreach (its shadow-casting point and spot lights), then the inventory and the magic menu (a menu
# scene's shadow masks, UI3DSceneManager::Render). Compare shadow-mask-org1.env's shots with these.
CS_ORG_TRIPWIRE_GUEST=1
CS_ORG_RESIDUE_CENSUS=1
CS_ORG_RESIDUE_CENSUS_FRAMES=300
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;700:coc Whiterun;1300:set timescale to 20;1310:fw 81a;1400:set timescale to 0;1401:set gamehour to 13;1500:dclf:shot=whiterun;1600:coc WhiterunDragonsreach;2400:dclf:shot=dragonsreach;2500:dclf:menu=InventoryMenu=show;2900:dclf:shot=inventory;2910:dclf:menu=InventoryMenu=hide;3000:dclf:menu=MagicMenu=show;3400:dclf:shot=magic;3410:dclf:menu=MagicMenu=hide
CS_DCLF_TEST_EXIT=3500
