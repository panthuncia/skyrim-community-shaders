# Dynamic Cubemaps on D3D11 (0) or on the render graph (1): Whiterun at 13:00 in clear weather with time stopped, then
# Dragonsreach, a shot of each. Compare water and metal reflections, and the composite's specular (it reads the cubemaps).
CS_ORG_DYNAMIC_CUBEMAPS=0
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2500:coc WhiterunDragonsreach;3600:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=3700
