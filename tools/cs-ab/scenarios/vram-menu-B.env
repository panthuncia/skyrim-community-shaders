# VRAM bisect, group B of vram-all.env's CS_ORG switches only (A engine resources, B engine passes, C feature ports).
# No tour: read CS-AB-memory.csv's kernel VRAM over the first 40 s (cs-ab -TimeoutSeconds 45).
# cs-ab: disable-mod=Skyrim Engine Telemetry
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_ORG_ENGINE_FLUSH_LATCH=1
CS_ORG_RESIDUE_CENSUS=1
CS_ORG_RESIDUE_CENSUS_FRAMES=300
CS_ORG_RESIDUE_CENSUS_TOP=60
CS_ORG_SHADOW_MASK=1
CS_ORG_ENGINE_CONSTANTS=1
CS_ORG_ENGINE_SKELETON=1
CS_ORG_SKY=1
CS_ORG_OCCLUSION_QUERIES=1
CS_ORG_WATER=1
CS_ORG_BLOOD_SPLATTER=1
CS_ORG_IMAGESPACE=1
CS_ORG_MENU3D=1
CS_ORG_MAP=1
CS_ORG_SCALEFORM=1
CS_ORG_BINK=1
CS_ORG_LOADING_THREAD=1
