# P5.12's reference (docs/development/p5/loading-screen.md): four loading screens (coc Whiterun, coc WhiterunDragonsreach,
# cow Blackreach, a save's load) and the startup logo, with the P4 switches, texture streaming, Scaleform and Bink on the graph,
# and the main-thread rule (CS_ORG_LOADING_THREAD unset): loading screens and the logo stay on D3D11. Compare with loading-org1.
CS_ORG_TRIPWIRE_GUEST=1
CS_ORG_ENGINE_TARGETS=1
CS_ORG_ENGINE_TARGET_HANDLES=1
CS_ORG_ENGINE_BUFFERS=1
CS_ORG_ENGINE_TEXTURES=1
CS_ORG_ENGINE_SHADERS=1
CS_ORG_TEXTURE_STREAMING=1
CS_ORG_SCALEFORM=1
CS_ORG_BINK=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;700:coc Whiterun;1500:dclf:shot=whiterun;1600:coc WhiterunDragonsreach;2400:dclf:shot=dragonsreach;2500:cow Blackreach 0 0;3300:dclf:shot=blackreach;3400:dclf:load=recent;4200:dclf:shot=loaded;4201:dclf:tex-stats
CS_DCLF_TEST_EXIT=4300
