# Tripwire handles (P4.1): the self-test at startup and the report. No handle is installed in the engine, so the run must look
# like the default one, and the report must list no call sites. Look for "[ORG] tripwire self-test: PASS" and
# "[ORG] tripwire report (exit): 0 call sites, 0 calls"; no "[ORG] tripwire:" warning lines.
CS_ORG_TRIPWIRE_SELFTEST=1
CS_ORG_TRIPWIRE_LOG=1
CS_ORG_TRIPWIRE_LOG_INTERVAL=30
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=300:coc Whiterun;1500:dclf:shot=whiterun
CS_DCLF_TEST_EXIT=1600
