# P5.6 bisection: imagespace-org1.env with only the bloom group on the graph (CS_ORG_IMAGESPACE_EFFECTS=bloom). A shot that differs
# from imagespace-org0.env in imagespace-org1.env and here points at this group. Any single effect name works too, e.g.
# CS_ORG_IMAGESPACE_EFFECTS=ISHDRDownSample4 (names in docs/development/p5/imagespace.md).
CS_ORG_ENGINE_CONSTANTS=1
CS_ORG_IMAGESPACE=1
CS_ORG_IMAGESPACE_EFFECTS=bloom
CS_ORG_IMAGESPACE_LOG=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2410:set gamehour to 23;2800:dclf:shot=whiterun-night;2810:set gamehour to 13;2900:dclf:menu=MapMenu=show;3300:dclf:shot=map;3310:dclf:menu=MapMenu=hide;3400:dclf:menu=Journal Menu=show;3700:dclf:shot=journal;3710:dclf:menu=Journal Menu=hide;3800:coc WhiterunDragonsreach;4900:dclf:shot=dragonsreach;5000:coc Riverwood;6100:fw 81a;6400:dclf:shot=riverwood
CS_DCLF_TEST_EXIT=6500
