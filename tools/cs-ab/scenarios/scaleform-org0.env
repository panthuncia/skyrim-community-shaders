# Scaleform on D3D11 (P5.10's reference for scaleform-org1.env): Whiterun at 13:00 in clear weather, a shot of the HUD, then the
# inventory, the map and the journal, each shown, shot and hidden again, and the HUD once more.
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=hud;2500:dclf:menu=InventoryMenu=show;2800:dclf:shot=inventory;2900:dclf:menu=InventoryMenu=hide;3100:dclf:menu=MapMenu=show;3500:dclf:shot=map;3600:dclf:menu=MapMenu=hide;3800:dclf:menu=Journal Menu=show;4100:dclf:shot=journal;4200:dclf:menu=Journal Menu=hide;4400:dclf:shot=hud-after
CS_DCLF_TEST_EXIT=4500
