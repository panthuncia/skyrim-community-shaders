# Dynamic Cubemaps on the render graph with its readers there too: the ORG composite and IBL read the published cubemaps' D3D11
# views. Same commands as dyncubemaps-org0/1; compare against dyncubemaps-org0 with CS_ORG_COMPOSITE=1 CS_ORG_IBL=1 left out.
CS_ORG_DYNAMIC_CUBEMAPS=1
CS_ORG_COMPOSITE=1
CS_ORG_IBL=1
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;602:fw 81a;700:coc Whiterun;2000:fw 81a;2400:dclf:shot=whiterun;2500:coc WhiterunDragonsreach;3600:dclf:shot=dragonsreach
CS_DCLF_TEST_EXIT=3700
