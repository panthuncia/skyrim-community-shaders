# effect-variants-census.env's tour under the set parity: "[DCLF] effects' Lighting variant (CS_DCLF_SET_PARITY): N engine passes of
# members checked (N kCloudLOD), N with a light 0 other than the port's" must say <- OK (the cloud-lit members' light 0 is the cloud
# light), and "[DCLF] main camera since the last report: ... <- LEAK" must not appear.
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_SET_PARITY=1
CS_DCLF_CENSUS=1
CS_DCLF_STATS=1
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;700:coc Whiterun;1500:dclf:mark=whiterun;2400:dclf:shot=ev-whiterun;2500:coc Riverwood;3300:dclf:mark=riverwood;4200:dclf:shot=ev-riverwood;4300:coc WhiterunDragonsreach;5100:dclf:mark=dragonsreach;6000:dclf:shot=ev-dragonsreach
CS_DCLF_TEST_TURN=1500:2300:0.25
CS_DCLF_TEST_EXIT=6100
