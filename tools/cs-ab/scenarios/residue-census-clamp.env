# residue-census.env with every shadow view drawn with depth clamped instead of clipped (CS_DCLF_TEST_SHADOW_CLAMP=1): the path a
# view takes when its rasterizer state turns depth clipping off, which no engine state in these cells does. The shots should match
# residue-census.env's but where a caster crosses a shadow view's near or far plane. The log's "[DCLF] shadow view rasterizer
# state N (mode ...): ... depth clamped" lines name the states; "[DCLF] shadow views:" should show no "raster-state" not-ready
# views and no "shadow view rasterizer state not expressible" warning (that one means the device has no depthClamp).
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_CENSUS=1
CS_DCLF_STATS=1
CS_DCLF_TEST_SHADOW_CLAMP=1
CS_DCLF_TEST_COMMANDS=600:set timescale to 0;601:set gamehour to 13;700:coc Whiterun;1700:dclf:shot=whiterun;1800:coc WhiterunDragonsreach;2700:dclf:shot=dragonsreach;2800:coc Riverwood;3800:dclf:shot=riverwood
CS_DCLF_TEST_EXIT=3900
