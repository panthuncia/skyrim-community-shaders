# The owned frame through window changes without key presses: focus away and back, minimize and restore (alt-tab), and a resize
# of the window. A shot after each to show the frame still presents.
CS_ORG_OWNED_FRAME=1
CS_ORG_CRASH_MARKERS=0
DXVK_DEBUG=hang
VK_LOADER_LAYERS_DISABLE=*nsight*
CS_DCLF_TEST_COMMANDS=500:dclf:shot=start;700:coc Whiterun;1700:dclf:shot=whiterun;1750:dclf:window=background;1900:dclf:window=foreground;2000:dclf:shot=focus;2050:dclf:window=minimize;2150:dclf:window=restore;2300:dclf:shot=restored;2350:dclf:window=1280x720;2500:dclf:shot=resized;2550:dclf:window=1920x1080;2700:dclf:shot=resized-back
CS_DCLF_TEST_EXIT=2800
